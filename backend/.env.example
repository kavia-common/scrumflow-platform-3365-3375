# Database configuration
# DATABASE_URL is required. Defaults to sqlite file if omitted.
DATABASE_URL=sqlite:///./scrum_mind.db
# Optional: seed example data on startup (1/true/yes/on)
SEED=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Jira MCP Integration (Required to enable Jira features)
# All of these must be set, otherwise Jira integration endpoints will return 503 and hooks will be skipped.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# MCP client command that reads JSON from stdin and outputs JSON on stdout.
# Example client must support tools: createIssue, transitionIssue, addComment
# If installed globally, the following works:
# MCP_CLIENT_CMD="mcp-jira --stdio"
# Otherwise provide full path, e.g.:
# MCP_CLIENT_CMD="/usr/local/bin/mcp-jira --stdio"
MCP_CLIENT_CMD="mcp-jira --stdio"

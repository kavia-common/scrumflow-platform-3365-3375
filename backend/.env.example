# Database
DATABASE_URL=sqlite:///./scrum_mind.db
SEED=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Jira MCP Integration (required for integration features)
# Replace placeholders with your actual Jira Cloud details and MCP client command.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ
# The MCP client must accept JSON on stdin and produce JSON on stdout.
# Example client: mcp-jira --stdio (ensure it's in PATH)
MCP_CLIENT_CMD="mcp-jira --stdio"

# Database
DATABASE_URL=sqlite:///./scrum_mind.db
SEED=true
LOG_LEVEL=INFO

# Jira MCP Integration (required for Jira endpoints)
# Set all of these to enable Jira integration. If any is missing, /integrations/jira/readiness will show enabled=false.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# MCP client command to execute. This command must be on PATH and support tools: createIssue, transitionIssue, addComment.
# Example for a stdio client: mcp-jira --stdio
MCP_CLIENT_CMD=mcp-jira --stdio

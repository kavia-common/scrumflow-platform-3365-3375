# PUBLIC_INTERFACE
# Backend environment variables required by Scrum Mind backend

# SQLAlchemy-compatible database URL (e.g. sqlite:///./scrum_mind.db)
DB_URL=sqlite:///./scrum_mind.db

# Secret used to sign JWTs (change in production)
JWT_SECRET=devchangeit

# Comma-separated list of allowed CORS origins for the frontend app
CORS_ORIGINS=http://localhost:3000

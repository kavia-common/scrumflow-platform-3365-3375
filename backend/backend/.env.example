# Database
DATABASE_URL=sqlite:///./scrum_mind.db
SEED=true

# Jira MCP Integration (Jira Cloud)
# Required for enabling Jira integration; if any are missing, integration will be disabled gracefully.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ
# Command to invoke MCP client which accepts JSON on stdin and returns JSON on stdout
# Example: mcp-jira --stdio or "node path/to/mcp-jira-client.js"
MCP_CLIENT_CMD=mcp-jira --stdio

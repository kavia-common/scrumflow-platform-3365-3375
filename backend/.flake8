[flake8]
# Exclude virtual environments and non-source directories to prevent linting third-party packages
exclude =
    .venv,
    venv,
    env,
    .git,
    __pycache__,
    .mypy_cache,
    .pytest_cache,
    build,
    dist,
    node_modules,
    .eggs,
    *.egg-info

# Adjust line length if needed for this project
max-line-length = 100

# Ignore codes that commonly conflict with Black/PEP8 nuances
ignore = E203, W503
